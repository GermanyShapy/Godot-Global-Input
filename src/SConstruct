import os
import sys
from SCons.Script import *

platform = ARGUMENTS.get("platform", sys.platform)
build_type = ARGUMENTS.get("build", "debug")

godot_cpp_path = "../godot-cpp"
sources = [
    "global_input.cpp",
    "register_types.cpp",
]

def fixpath(p):
    return os.path.abspath(p).replace("\\", "/")

host_platform = sys.platform.lower()
is_wsl = "microsoft" in os.uname().release.lower() if hasattr(os, "uname") else False
output_dir = ""

if platform.startswith("win"):
    if host_platform.startswith("win"):
        cxx = "g++"
        cc = "gcc"
    else:
        cxx = "x86_64-w64-mingw32-g++"
        cc = "x86_64-w64-mingw32-gcc"

elif platform.startswith("linux"):
    cxx = "g++"
    cc = "gcc"

elif platform.startswith("mac"):
    # Native clang on a macOS host (CI runners, local Macs); osxcross only when
    # cross-compiling from Linux/Windows.
    if host_platform.startswith("darwin"):
        cxx = "clang++"
        cc = "clang"
    else:
        cxx = "o64-clang++"
        cc = "o64-clang"

    arch = ARGUMENTS.get("arch", "universal")

else:
    print(f"Unsupported target platform: {platform}")
    Exit(1)

print(f"Host: {host_platform}, Target: {platform}, Using compiler: {cxx}")

env = Environment(tools=["default"])
env["CXX"] = cxx
env["CC"] = cc
env["ENV"]["PATH"] = os.environ["PATH"]
env["ENV"]["PWD"] = os.getcwd()

if platform.startswith("win"):
    env = Environment(tools=["mingw"])
    mingw_bin_path = os.environ.get("MINGW_BIN", "C:/msys64/ucrt64/bin")
    output_dir = "bin/windows"
    os.makedirs(output_dir, exist_ok=True)

    # SCons shells out through cmd.exe, which cannot use a PATH formatted for
    # MSYS/Git-Bash. Call the toolchain by absolute path, and prepend its
    # native-form directory so ar/ranlib resolve as well.
    env["CXX"] = fixpath(mingw_bin_path + "/g++")
    env["CC"] = fixpath(mingw_bin_path + "/gcc")
    env["ENV"]["PATH"] = os.path.abspath(mingw_bin_path).replace("/", "\\") \
        + os.pathsep + env["ENV"].get("PATH", "")

    lib_suffix = "windows.template_debug.x86_64" if build_type == "debug" else "windows.template_release.x86_64"
    env["SHLIBSUFFIX"] = ".dll"

    env.Append(CPPPATH=[
        f"{godot_cpp_path}/include",
        f"{godot_cpp_path}/include/godot_cpp",
        f"{godot_cpp_path}/gen/include",
        f"{godot_cpp_path}/gdextension",
        "src"
    ])

    env.Append(LIBPATH=[
        f"{godot_cpp_path}/bin",
    ])

    env.Append(LIBS=[
        f"godot-cpp.{lib_suffix}",
        "user32",
        "winpthread"
    ])

    env.Append(CXXFLAGS=["-std=c++17", "-O2", "-fPIC"])
    env.Append(CPPDEFINES=["NOMINMAX"])
    env.Append(LINKFLAGS=["-shared"])

    required_dlls = ["libstdc++-6.dll", "libgcc_s_seh-1.dll", "libwinpthread-1.dll"]
    for dll in required_dlls:
        src_path = os.path.join(mingw_bin_path, dll)
        dst_path = os.path.join(output_dir, dll)
        if os.path.isfile(src_path):
            env.Execute(Copy(dst_path, src_path))

elif platform.startswith("linux"):
    output_dir = "bin/linux"
    os.makedirs(output_dir, exist_ok=True)

    lib_suffix = "linux.template_debug.x86_64" if build_type == "debug" else "linux.template_release.x86_64"

    env.Append(CPPPATH=[
        f"{fixpath(godot_cpp_path)}/include",
        f"{fixpath(godot_cpp_path)}/include/godot_cpp",
        f"{fixpath(godot_cpp_path)}/gen/include",
        f"{fixpath(godot_cpp_path)}/gdextension",
        "src"
    ])

    env.Append(LIBPATH=[
        f"{fixpath(godot_cpp_path)}/bin",
        "/usr/lib/x86_64-linux-gnu"
    ])

    env.Append(LIBS=[
        f"godot-cpp.{lib_suffix}",
        "pthread"
    ])

    env.Append(RPATH=[
        '/usr/lib/x86_64-linux-gnu',
        env.Literal('\\$$ORIGIN'),
        env.Literal('\\$$ORIGIN/GI/linux')
    ])

    env.Append(CXXFLAGS=["-std=c++17", "-O2", "-fPIC"])

elif platform.startswith("mac"):
    output_dir = "bin/macos"
    os.makedirs(output_dir, exist_ok=True)

    lib_suffix = f"macos.template_{build_type}.{arch}"

    env["SHLIBSUFFIX"] = ".dylib"

    env.Append(CPPPATH=[
        f"{fixpath(godot_cpp_path)}/include",
        f"{fixpath(godot_cpp_path)}/include/godot_cpp",
        f"{fixpath(godot_cpp_path)}/gen/include",
        f"{fixpath(godot_cpp_path)}/gdextension",
        "src"
    ])

    env.Append(LIBPATH=[
        f"{fixpath(godot_cpp_path)}/bin",
    ])

    env.Append(LIBS=[
        f"godot-cpp.{lib_suffix}",
    ])

    env.Append(CXXFLAGS=["-std=c++17", "-O2", "-fPIC"])

    # This file drives the compiler directly, so scons' own -arch handling is
    # bypassed: without forwarding it explicitly a "universal" build would
    # silently produce a host-only binary under a universal name.
    arch_flags = (
        ["-arch", "x86_64", "-arch", "arm64"]
        if arch == "universal"
        else ["-arch", arch]
    )
    env.Append(CCFLAGS=arch_flags)
    env.Append(CXXFLAGS=arch_flags)

    env.Append(LINKFLAGS=arch_flags + [
        "-shared",
        # macOS ld rejects undefined symbols by default, but a GDExtension
        # resolves godot-cpp's symbols from the host engine at load time.
        "-undefined", "dynamic_lookup",
        "-framework", "CoreFoundation",
        "-framework", "ApplicationServices",
    ])

# The .gdextension files reference the library by its bare name, so drop the
# platform default prefix: scons would otherwise emit libGlobalInput.*, which
# the extension can never find.
env["SHLIBPREFIX"] = ""

target_name = (
    f"bin/windows/GlobalInput.{lib_suffix}.dll" if platform.startswith("win")
    else f"bin/linux/GlobalInput.{lib_suffix}.so" if platform.startswith("linux")
    else f"bin/macos/GlobalInput.{lib_suffix}.dylib"
)

env.SharedLibrary(target=target_name, source=sources)
